{
  "name": "DATA 730 assignment",
  "image": "ghcr.io/unc-data-730/env:latest",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postStartCommand": "jupyter lab --no-browser --ip=0.0.0.0 --port=8888 --IdentityProvider.token='' --ServerApp.root_dir=${containerWorkspaceFolder}",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "JupyterLab", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "REditorSupport.r"
      ]
    }
  }
}
